{
  "name": "study-system-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Study System — personal curriculum, lessons, Q&A, flashcards and Habit Tracker integration",
  "scripts": {
    "dev": "concurrently -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite web",
    "build": "tsc -p tsconfig.server.json && vite build web",
    "start": "node dist-server/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint src tests web/src scripts",
    "validate:content": "tsx scripts/validate-content.ts",
    "smoke": "tsx scripts/smoke.ts",
    "seed:outline": "tsx scripts/import-obsidian-outline.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "dompurify": "^3.2.4",
    "express": "^4.21.2",
    "marked": "^15.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "eslint": "^9.20.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
