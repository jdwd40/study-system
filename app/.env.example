# Copy to .env for local dev; on the server, set these in the process manager environment.
# NEVER commit real values.

# Port/host for the single Node process serving /study/ and /study/api/
PORT=4173
HOST=127.0.0.1

# App-owned SQLite database (outside Git). Default: app/data/study.db
STUDY_DB_PATH=

# Canonical content tree + repo root (defaults resolve from the app directory)
STUDY_CONTENT_DIR=
STUDY_REPO_ROOT=

# Built frontend directory (default: app/web/dist)
STUDY_WEB_DIST=

# Single-user auth. Generate with: npx tsx -e "import('./src/server/auth.ts').then(m=>console.log(m.hashPassword('YOUR_PASSWORD')))"
STUDY_PASSWORD_HASH=

# Development-only auth bypass. Ignored when NODE_ENV=production. Never set on the server.
STUDY_DEV_BYPASS=0

# Bearer secret for the local Hermes integration adapter (/study/api/integration/*)
STUDY_INTEGRATION_SECRET=

NODE_ENV=development
